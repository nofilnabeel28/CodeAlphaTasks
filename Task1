import pandas as pd
import requests
from bs4 import BeautifulSoup


def scrape_books(max_pages=2):
    # Data store karne ke liye list
    books_data = []

    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Safari/537.36"
    }

    print("Scraping shuru ho rahi hai...\n")

    for page in range(1, max_pages + 1):
        url = f"http://books.toscrape.com/catalogue/page-{page}.html"
        response = requests.get(url, headers=headers)

        if response.status_code != 200:
            print(f"Page {page} fetch nahi ho saka. Status code: {response.status_code}")
            continue

        # HTML parse kar rahe hain
        soup = BeautifulSoup(response.text, "html.parser")

        # Tamam book items select kar rahe hain
        books = soup.find_all("article", class_="product_pod")

        for book in books:
            # 1. Book Title
            title = book.h3.a["title"]

            # 2. Price
            price = book.find("p", class_="price_color").text

            # 3. Availability Stock status
            availability = book.find("p", class_="instock availability").text.strip()

            # 4. Rating
            rating_class = book.find("p", class_="star-rating")["class"]
            rating = rating_class[1] if len(rating_class) > 1 else "No Rating"

            # Dictionary me save kar rahe hain
            books_data.append(
                {
                    "Title": title,
                    "Price": price,
                    "Availability": availability,
                    "Rating": rating,
                }
            )

        print(f"Page {page} successfully scrape ho gaya.")

    # DataFrame banana aur CSV me save karna
    df = pd.DataFrame(books_data)
    df.to_csv("scraped_books_dataset.csv", index=False)

    print("\nDataset ready hai! 'scraped_books_dataset.csv' save ho chuki hai.")
    return df


# Script run karna
if __name__ == "__main__":
    df_books = scrape_books(max_pages=2)

    # Scraped data ki pehli 5 rows dekhne ke liye:
    print("\nSample Data:")
    print(df_books.head())
